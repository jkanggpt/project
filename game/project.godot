; Engine configuration file.
; 마법성채 키우기 — Godot 4.7.2 .NET, Compatibility 렌더러
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="마법성채 키우기"
config/description="폐허가 된 언덕 위 성채를 촌락에서 왕성으로 키우는 중세 판타지 경영 게임"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.105882, 0.0901961, 0.12549, 1)

[autoload]

Core="*res://scripts/core/CoreBridge.cs"
GameClock="*res://scripts/core/GameClock.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="MagicCastle"

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.105882, 0.0901961, 0.12549, 1)
