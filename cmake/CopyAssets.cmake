file(READ "${MANIFEST}" json)
string(JSON count LENGTH "${json}" assets)
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
  string(JSON path GET "${json}" assets ${index} path)
  get_filename_component(parent "${DESTINATION}/${path}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(COPY_FILE "${SOURCE}/${path}" "${DESTINATION}/${path}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${MANIFEST}" "${DESTINATION}/assets_manifest.json" ONLY_IF_DIFFERENT)
