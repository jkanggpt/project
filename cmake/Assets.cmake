# 런타임·검사기·설치 목록은 같은 JSON 원장을 사용합니다.
set(CASTLE_ASSET_MANIFEST "${PROJECT_SOURCE_DIR}/game/assets/assets_manifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CASTLE_ASSET_MANIFEST}")
file(READ "${CASTLE_ASSET_MANIFEST}" CASTLE_ASSET_JSON)
string(JSON CASTLE_ASSET_COUNT LENGTH "${CASTLE_ASSET_JSON}" assets)
set(CASTLE_ASSET_HEADER "#ifndef CASTLE_ASSET_INDEX_H\n#define CASTLE_ASSET_INDEX_H\n#include <stdint.h>\ntypedef struct CastleAssetRecord { const char *id,*path,*kind,*source,*stage_file; int width,height,columns,rows,frames; uint32_t crc; } CastleAssetRecord;\nstatic const CastleAssetRecord CASTLE_ASSETS[] = {\n")
set(CASTLE_RUNTIME_ASSET_PATHS)
set(CASTLE_RUNTIME_ASSET_IDS)
math(EXPR CASTLE_ASSET_LAST "${CASTLE_ASSET_COUNT}-1")
foreach(index RANGE ${CASTLE_ASSET_LAST})
  string(JSON asset_json GET "${CASTLE_ASSET_JSON}" assets ${index})
  foreach(field id path kind source stage_file width height columns rows frames crc32)
    string(JSON asset_${field} GET "${asset_json}" ${field})
  endforeach()
  if(asset_path MATCHES "(^/|\\.\\.|\\\\|:)" OR asset_path IN_LIST CASTLE_RUNTIME_ASSET_PATHS)
    message(FATAL_ERROR "Invalid/duplicate asset path: ${asset_path}")
  endif()
  if(NOT asset_id MATCHES "^[A-Za-z0-9_.-]+$" OR asset_id IN_LIST CASTLE_RUNTIME_ASSET_IDS)
    message(FATAL_ERROR "Invalid/duplicate asset ID: ${asset_id}")
  endif()
  list(APPEND CASTLE_RUNTIME_ASSET_IDS "${asset_id}")
  list(APPEND CASTLE_RUNTIME_ASSET_PATHS "${asset_path}")
  string(APPEND CASTLE_ASSET_HEADER "{\"${asset_id}\",\"${asset_path}\",\"${asset_kind}\",\"${asset_source}\",\"${asset_stage_file}\",${asset_width},${asset_height},${asset_columns},${asset_rows},${asset_frames},UINT32_C(${asset_crc32})},\n")
endforeach()
string(APPEND CASTLE_ASSET_HEADER "};\n#define CASTLE_ASSET_COUNT ${CASTLE_ASSET_COUNT}\n#endif\n")
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated")
file(WRITE "${PROJECT_BINARY_DIR}/generated/assets_index.h" "${CASTLE_ASSET_HEADER}")
add_library(castle_asset_index INTERFACE)
target_include_directories(castle_asset_index INTERFACE "${PROJECT_BINARY_DIR}/generated")
