execute_process(COMMAND "${INSPECT}" "${SEEDS}" OUTPUT_FILE "${OUTPUT}" ERROR_VARIABLE details RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "World inspection failed: ${details}")
endif()
file(STRINGS "${GOLDEN}" expected)
file(STRINGS "${OUTPUT}" actual)
list(LENGTH actual count)
math(EXPR required "${SEEDS}+1")
if(NOT count EQUAL required)
  message(FATAL_ERROR "Missing world observations")
endif()
foreach(index RANGE 1 ${SEEDS})
  list(GET expected ${index} a)
  list(GET actual ${index} b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "World golden differs at seed ${index}: ${a} / ${b}")
  endif()
endforeach()
message(STATUS "World golden: ${SEEDS} seeds identical")
