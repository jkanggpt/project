{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contact_profile.schema.json",
  "title": "원화에 정합된 지면 접촉 프로필",
  "description": "실제 알파와 접촉점 표시에 근거한 제작 자료의 계약입니다. 보이지 않는 발자국 깊이는 명시적으로 작성합니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status", "source_asset", "source_sha256", "source_rect", "anchor_px", "world_size", "alpha_threshold", "supports", "upper_proxy"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "status": {"enum": ["candidate", "reviewed"]},
    "source_asset": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_rect": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "anchor_px": {"$ref": "#/$defs/point"},
    "world_size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "alpha_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "supports": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "visible_front_px", "footprint_world", "exact_lower_height"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "visible_front_px": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}},
          "footprint_world": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point"}},
          "exact_lower_height": {"type": "number", "exclusiveMinimum": 0},
          "annotation_note": {"type": "string"}
        }
      }
    },
    "upper_proxy": {"enum": ["ellipsoid", "box_roof", "capsule", "hull"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "review_note": {"type": "string"}
  },
  "$defs": {
    "point": {
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2, "maxItems": 2
    }
  }
}
